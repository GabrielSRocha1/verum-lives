# ===== Básico =====
NODE_ENV=production
BASE_URL=https://lives.seudominio.com
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=1
DATA_DIR=/var/lib/verum-lives
# Domínios extras que podem enviar o formulário (ex.: versão com www), separados por vírgula
ALLOWED_ORIGINS=
# E-mail exibido na política de privacidade para pedidos LGPD (opcional)
PRIVACY_CONTACT_EMAIL=

# ===== Chaves (obrigatórias em produção) — gere com: npm run keys:generate =====
DATA_ENCRYPTION_KEY=
INDEX_KEY=
APP_SECRET=

# ===== Primeiro administrador (usado só se não houver nenhum; depois apague daqui) =====
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ===== Brevo (e-mail transacional + lista de contatos) =====
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Verum Cripto
BREVO_LIST_ID=
BREVO_WEBHOOK_TOKEN=

# ===== WhatsApp Business Cloud API (oficial da Meta) =====
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# ===== Google Sheets (planilha "verum-lives" via Web App do Apps Script) =====
# URL /exec da implantação do Web App (conta dona da planilha) e segredo compartilhado
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_SECRET=

# ===== n8n (eventos assinados) =====
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ===== Cloudflare Turnstile (antispam opcional) =====
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ===== Ajustes finos (opcionais) =====
# FORM_MIN_FILL_MS=2500
# EMAIL_DNS_CHECK=1
# RL_REGISTER_PER_IP=6
# REMINDER_GRACE_MINUTES=20
# DISPATCHER_INTERVAL_MS=30000
# SESSION_TTL_HOURS=12
